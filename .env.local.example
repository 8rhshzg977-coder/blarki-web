# Copy this file to .env.local and fill in real values for local development.
# In production (Vercel), set these same names under Project Settings -> Environment Variables.
# Never commit the filled-in .env.local file — it's already excluded via .gitignore.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase -> Project Settings -> API -> service_role secret (server-only, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Stripe -> Developers -> API keys (use a test-mode key while developing)
STRIPE_SECRET_KEY=
# Stripe -> Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=
# Stripe -> Product catalog -> the Starter plan's Price ID (starts with "price_")
STRIPE_STARTER_PRICE_ID=
